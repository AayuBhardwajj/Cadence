# Environment variables for Cadence session-service

# Local Docker Compose Postgres (default):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cadence
# DB_USER=cadence
# DB_PASSWORD=cadence_dev

# Live Supabase Postgres (required until infrastructure/postgres/init.sql
# is consolidated per ROADMAP.md Phase 0 — assessment_sessions/
# assessment_reports currently only exist in the hosted project):
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=<from Supabase dashboard, Project Settings > Database>

