CADENCE_ENV=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT & Authentication (D27)
# Allowed signing algorithms (e.g. ES256,HS256)
SUPABASE_JWT_ALLOWED_ALGORITHMS=
# Prod issuer: <project-url>/auth/v1 (e.g. https://<project-ref>.supabase.co/auth/v1)
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Supabase JWT Secret (WARNING: Local default secret must never be used in prod!)
SUPABASE_JWT_SECRET=
# Prod JWKS URL: <issuer>/.well-known/jwks.json (e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json)
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_PUBLIC_KEY_PEM=

DB_URL=
DB_USER=
DB_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
REDIS_HOST=
REDIS_PORT=
GROQ_API_KEY=
GEMINI_API_KEY=
ALLOWED_ORIGINS=
STORAGE_BUCKET_NAME=
CADENCE_INTERNAL_SERVICE_KEY=
