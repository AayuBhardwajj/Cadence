CADENCE_ENV=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT & Authentication (D27)
# Local Supabase CLI issues ES256 tokens; HS256 is supported for legacy/service tokens.
SUPABASE_JWT_ALLOWED_ALGORITHMS=
# Local issuer: http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Local default secret (WARNING: development ONLY — must never be used in prod)
SUPABASE_JWT_SECRET=
# Local JWKS URL: http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_PUBLIC_KEY_PEM=

DB_URL=
DB_USER=
DB_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
REDIS_HOST=
REDIS_PORT=
GROQ_API_KEY=
GEMINI_API_KEY=
ALLOWED_ORIGINS=
STORAGE_BUCKET_NAME=
CADENCE_INTERNAL_SERVICE_KEY=
